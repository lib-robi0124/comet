@model IEnumerable<BidVM>
@{
    ViewData["Title"] = $"Bids for {ViewBag.ProductCode}";
    var statistics = ViewBag.Statistics as BidStatisticsVM;
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <a href="@Url.Action("Details", new { id = ViewContext.RouteData.Values["id"] })"
           class="btn btn-link text-decoration-none">
            <i class="fas fa-arrow-left me-2"></i>Back to Product
        </a>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 pt-4">
                    <h4 class="mb-0">
                        <i class="fas fa-history me-2 text-info"></i>Bid History - @ViewBag.ProductCode
                    </h4>
                </div>
                <div class="card-body">
                    @if (statistics != null)
                    {
                        <div class="row g-3 mb-4">
                            <div class="col-md-3">
                                <div class="bg-light p-3 rounded-3">
                                    <small class="text-muted d-block">Total Bids</small>
                                    <h5 class="mb-0">@statistics.TotalBids</h5>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="bg-light p-3 rounded-3">
                                    <small class="text-muted d-block">Unique Bidders</small>
                                    <h5 class="mb-0">@statistics.UniqueBidders</h5>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="bg-light p-3 rounded-3">
                                    <small class="text-muted d-block">Highest Bid</small>
                                    <h5 class="mb-0">@statistics.CurrentHighestBidDisplay</h5>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="bg-light p-3 rounded-3">
                                    <small class="text-muted d-block">Average Bid</small>
                                    <h5 class="mb-0">@statistics.AverageBidDisplay</h5>
                                </div>
                            </div>
                        </div>
                    }

                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Bidder</th>
                                        <th>Amount</th>
                                        <th>Time</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var bid in Model.OrderByDescending(b => b.Amount))
                                    {
                                        <tr>
                                            <td>@bid.CompanyName</td>
                                            <td><strong>@bid.Amount.ToString("C")</strong></td>
                                            <td>@bid.BidTime?.ToString("MMM dd, yyyy HH:mm:ss")</td>
                                            <td>
                                                @if (bid.Amount == Model.Max(b => b.Amount))
                                                {
                                                    <span class="badge bg-success">Highest</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-4">No bids have been placed yet.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>