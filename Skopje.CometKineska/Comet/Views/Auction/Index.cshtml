@model AuctionDashboardVM
@{
    ViewData["Title"] = "Live Auctions";
}

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm bg-gradient-primary text-white">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h1 class="h2 mb-2">
                                <i class="fas fa-gavel me-2"></i>Live Auctions
                            </h1>
                            <p class="mb-0 opacity-75">Browse and bid on available steel products</p>
                        </div>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div>
                                <a href="@Url.Action("MyBids")" class="btn btn-light">
                                    <i class="fas fa-list me-2"></i>My Bids
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Stats Cards for Logged-in Users -->
        <div class="row g-4 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0 bg-primary bg-opacity-10 p-3 rounded-3">
                                <i class="fas fa-gavel fs-3 text-primary"></i>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="text-muted mb-1">My Bids</h6>
                                <h2 class="mb-0">@Model.Stats.TotalMyBids</h2>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0 bg-success bg-opacity-10 p-3 rounded-3">
                                <i class="fas fa-trophy fs-3 text-success"></i>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="text-muted mb-1">Winning</h6>
                                <h2 class="mb-0">@Model.Stats.WinningBids</h2>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0 bg-warning bg-opacity-10 p-3 rounded-3">
                                <i class="fas fa-chart-line fs-3 text-warning"></i>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="text-muted mb-1">Win Rate</h6>
                                <h2 class="mb-0">@Model.Stats.WinRate.ToString("F0")%</h2>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0 bg-info bg-opacity-10 p-3 rounded-3">
                                <i class="fas fa-dollar-sign fs-3 text-info"></i>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="text-muted mb-1">Total Bid Value</h6>
                                <h2 class="mb-0">@Model.Stats.TotalBidValueDisplay</h2>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Search and Filter Section -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="fas fa-search text-muted"></i>
                        </span>
                        <input type="text"
                               class="form-control border-start-0 ps-0"
                               name="search"
                               value="@Model.SearchTerm"
                               placeholder="Search by product code, grade, or description...">
                    </div>
                </div>
                <div class="col-md-4">
                    <select class="form-select" name="category" onchange="this.form.submit()">
                        <option value="">All Categories</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.Name" selected="@(category.IsSelected ? "selected" : null)">
                                @category.DisplayText
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search me-2"></i>Search
                    </button>
                </div>
                @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.SelectedCategory))
                {
                    <div class="col-12">
                        <a href="@Url.Action("Index")" class="btn btn-sm btn-link text-danger">
                            <i class="fas fa-times me-1"></i>Clear Filters
                        </a>
                    </div>
                }
            </form>
        </div>
    </div>

    <!-- Products Grid -->
    <div class="row g-4">
        @if (Model.Products.Any())
        {
            @foreach (var product in Model.Products)
            {
                <div class="col-xl-4 col-lg-6">
                    <div class="card border-0 shadow-sm h-100 hover-shadow">
                        <div class="card-body">
                            <!-- Status Badge -->
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="card-title mb-1">@product.ProductCode</h5>
                                    <span class="badge bg-secondary">@product.ProductCategory</span>
                                </div>
                                <span class="badge @(product.IsAuctionActive ? "bg-success" : "bg-secondary") p-2">
                                    @(product.IsAuctionActive ? "ACTIVE" : "ENDED")
                                </span>
                            </div>

                            <!-- Product Specifications -->
                            <div class="mb-3">
                                <div class="row g-2">
                                    <div class="col-6">
                                        <small class="text-muted d-block">Grade</small>
                                        <span class="fw-bold">@product.Grade</span>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted d-block">Thickness</small>
                                        <span class="fw-bold">@product.Thickness mm</span>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted d-block">Width</small>
                                        <span class="fw-bold">@product.Width mm</span>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted d-block">Quantity</small>
                                        <span class="fw-bold">@product.Quantity @product.UnitOfMeasure</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Colors & Coating -->
                            <div class="mb-3">
                                <small class="text-muted d-block mb-1">Colors & Coating</small>
                                <div class="d-flex gap-2">
                                    <span class="badge bg-light text-dark">@product.ColorTopSide</span>
                                    <span class="badge bg-light text-dark">@product.ColorBottomSide</span>
                                    <span class="badge bg-light text-dark">Zinc: @product.ZincCoating</span>
                                </div>
                            </div>

                            <!-- Bid Information -->
                            <div class="bg-light p-3 rounded-3 mb-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <small class="text-muted d-block">Starting Price</small>
                                        <span class="h6 mb-0">@product.StartingPriceDisplay</span>
                                    </div>
                                    <div class="text-end">
                                        <small class="text-muted d-block">Current Bid</small>
                                        <span class="h5 mb-0 text-primary fw-bold">@product.CurrentBidDisplay</span>
                                    </div>
                                </div>
                                @if (product.BidCount > 0)
                                {
                                    <div class="mt-2">
                                        <small class="text-muted">
                                            <i class="fas fa-users me-1"></i>@product.BidCount bids
                                        </small>
                                    </div>
                                }
                            </div>

                            <!-- Time Remaining -->
                            <div class="mb-3">
                                <div class="d-flex align-items-center text-muted small">
                                    <i class="fas fa-clock me-2"></i>
                                    <span class="@(product.TimeRemaining.Contains("left") ? "text-success" : "text-danger")">
                                        @product.TimeRemaining
                                    </span>
                                </div>
                            </div>

                            <!-- Action Button -->
                            @if (product.IsAuctionActive)
                            {
                                <a href="@Url.Action("Details", new { id = product.Id })"
                                   class="btn btn-outline-primary w-100">
                                    <i class="fas fa-gavel me-2"></i>Place Bid
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-outline-secondary w-100" disabled>
                                    <i class="fas fa-ban me-2"></i>Auction Ended
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-box-open fa-4x text-muted mb-3"></i>
                        <h4 class="text-muted mb-3">No Active Auctions Found</h4>
                        <p class="text-muted mb-4">There are currently no products available for bidding.</p>
                        @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.SelectedCategory))
                        {
                            <a href="@Url.Action("Index")" class="btn btn-primary">
                                <i class="fas fa-undo me-2"></i>Clear Filters
                            </a>
                        }
                        else
                        {
                            <a href="@Url.Action("Index", "Home")" class="btn btn-primary">
                                <i class="fas fa-home me-2"></i>Go to Home
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (User.Identity?.IsAuthenticated == true && Model.MyRecentBids.Any())
    {
        <!-- My Recent Bids Section -->
        <div class="row mt-5">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-0 pt-4 d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="fas fa-history me-2 text-info"></i>My Recent Bids
                        </h5>
                        <a href="@Url.Action("MyBids")" class="btn btn-sm btn-link">View All</a>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Product</th>
                                        <th>My Bid</th>
                                        <th>Current Highest</th>
                                        <th>Bid Time</th>
                                        <th>Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var bid in Model.MyRecentBids)
                                    {
                                        <tr>
                                            <td><strong>@bid.ProductCode</strong></td>
                                            <td>@bid.MyBidDisplay</td>
                                            <td>@bid.CurrentBidDisplay</td>
                                            <td>@bid.TimeDisplay</td>
                                            <td>
                                                <span class="badge bg-@bid.StatusClass">@bid.Status</span>
                                            </td>
                                            <td>
                                                <a href="@Url.Action("Details", new { id = bid.ProductId })"
                                                   class="btn btn-sm btn-outline-primary">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Styles {
    <style>
        .hover-shadow {
            transition: all 0.3s ease;
        }

            .hover-shadow:hover {
                transform: translateY(-5px);
                box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.15) !important;
            }

        .bg-gradient-primary {
            background: linear-gradient(45deg, #0d6efd, #0b5ed7);
        }
    </style>
}
