@model ProductDetailsVM
@{
    ViewData["Title"] = $"Bid on {Model.ProductCode}";
    var bidModel = ViewBag.BidViewModel as BidVM;
}

<div class="container-fluid py-4">
    <!-- Back Button -->
    <div class="mb-4">
        <a href="@Url.Action("Index", new { search = Context.Request.Query["search"], category = Context.Request.Query["category"] })"
           class="btn btn-link text-decoration-none">
            <i class="fas fa-arrow-left me-2"></i>Back to Auctions
        </a>
    </div>

    <div class="row g-4">
        <!-- Product Details -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <!-- Header -->
                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <div>
                            <h1 class="h3 mb-2">@Model.ProductCode</h1>
                            <div class="d-flex gap-2">
                                <span class="badge bg-secondary">@Model.ProductCategory</span>
                                <span class="badge bg-info">Grade: @Model.Grade</span>
                            </div>
                        </div>
                        <span class="badge @(Model.IsAuctionActive ? "bg-success" : "bg-secondary") p-3">
                            @(Model.IsAuctionActive ? "ACTIVE" : "AUCTION ENDED")
                        </span>
                    </div>

                    <!-- Product Specifications Card -->
                    <div class="row g-4 mb-4">
                        <div class="col-md-12">
                            <div class="card bg-light border-0">
                                <div class="card-body">
                                    <h6 class="card-title mb-3">Product Specifications</h6>
                                    <div class="row">
                                        <div class="col-md-4 mb-3">
                                            <small class="text-muted d-block">Thickness</small>
                                            <strong>@Model.Thickness mm</strong>
                                        </div>
                                        <div class="col-md-4 mb-3">
                                            <small class="text-muted d-block">Width</small>
                                            <strong>@Model.Width mm</strong>
                                        </div>
                                        <div class="col-md-4 mb-3">
                                            <small class="text-muted d-block">Zinc Coating</small>
                                            <strong>@Model.ZincCoating</strong>
                                        </div>
                                        <div class="col-md-4 mb-3">
                                            <small class="text-muted d-block">Color Top Side</small>
                                            <strong>@Model.ColorTopSide</strong>
                                        </div>
                                        <div class="col-md-4 mb-3">
                                            <small class="text-muted d-block">Color Bottom Side</small>
                                            <strong>@Model.ColorBottomSide</strong>
                                        </div>
                                        <div class="col-md-4 mb-3">
                                            <small class="text-muted d-block">Weight</small>
                                            <strong>@Model.GrossWeight kg (Gross) / @Model.NetWeight kg (Net)</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Description -->
                    @if (!string.IsNullOrEmpty(Model.FullDescription))
                    {
                        <div class="mb-4">
                            <h5 class="mb-3">Description</h5>
                            <p class="text-muted">@Model.FullDescription</p>
                        </div>
                    }

                    <!-- Defects if any -->
                    @if (!string.IsNullOrEmpty(Model.Defects))
                    {
                        <div class="mb-4">
                            <h5 class="mb-3">Defects / Notes</h5>
                            <div class="alert alert-warning">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                @Model.Defects
                            </div>
                        </div>
                    }

                    <!-- Bid History -->
                    @if (Model.BidHistory.Any())
                    {
                        <div>
                            <h5 class="mb-3">Bid History (@Model.BidCount bids)</h5>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Bidder</th>
                                            <th>Amount</th>
                                            <th>Time</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var bid in Model.BidHistory.OrderByDescending(b => b.BidTime))
                                        {
                                            <tr class="@bid.RowClass">
                                                <td>
                                                    @bid.BidderName
                                                    @if (bid.IsCurrentUser)
                                                    {
                                                        <span class="badge bg-primary ms-2">You</span>
                                                    }
                                                </td>
                                                <td><strong>@bid.AmountDisplay</strong></td>
                                                <td>@bid.TimeDisplay</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-history fa-3x text-muted mb-3"></i>
                            <p class="text-muted">No bids yet. Be the first to bid!</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Bidding Section -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm sticky-top" style="top: 20px;">
                <div class="card-body p-4">
                    <h4 class="mb-4">Place Your Bid</h4>

                    <!-- Current Price Info -->
                    <div class="bg-primary bg-opacity-10 p-3 rounded-3 mb-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted d-block">Starting Price</small>
                                <span class="h6 mb-0">@Model.Price</span>
                            </div>
                            <div class="text-end">
                                <small class="text-muted d-block">Current Highest</small>
                                <span class="h4 mb-0 text-primary fw-bold">@Model.CurrentHighestBid</span>
                            </div>
                        </div>
                    </div>

                    <!-- Time Remaining -->
                    <div class="mb-4">
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="text-muted">Time Remaining:</span>
                            <span class="fw-bold @(Model.TimeRemaining.Contains("left") ? "text-success" : "text-danger")">
                                @Model.TimeRemaining
                            </span>
                        </div>
                    </div>

                    @if (Model.IsAuctionActive)
                    {
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-action="PlaceBid" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" asp-for="@bidModel.ProductId" value="@Model.Id" />
                                <input type="hidden" asp-for="@bidModel.ProductCode" value="@Model.ProductCode" />

                                <div class="mb-3">
                                    <label asp-for="@bidModel.CompanyName" class="form-label">Your Name/Company</label>
                                    <input asp-for="@bidModel.CompanyName" class="form-control" required />
                                    <span asp-validation-for="@bidModel.CompanyName" class="text-danger"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="@bidModel.Amount" class="form-label">Your Bid Amount ($)</label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input asp-for="@bidModel.Amount"
                                               class="form-control form-control-lg"
                                               type="number"
                                               step="0.01"
                                               min="@Model.MinimumNextBid"
                                               value="@Model.MinimumNextBid"
                                               required />
                                    </div>
                                    <small class="text-muted">
                                        Minimum bid: @Model.MinimumNextBid.ToString("C")
                                    </small>
                                    <span asp-validation-for="@bidModel.Amount" class="text-danger"></span>
                                </div>

                                <button type="submit" class="btn btn-primary btn-lg w-100">
                                    <i class="fas fa-gavel me-2"></i>Place Bid
                                </button>
                            </form>

                            <!-- Quick bid buttons -->
                            <div class="mt-3">
                                <small class="text-muted d-block mb-2">Quick bid:</small>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-outline-secondary btn-sm flex-fill"
                                            onclick="document.querySelector('input[name='Amount']').value = @(Model.MinimumNextBid + 10)">
                                        +$10
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm flex-fill"
                                            onclick="document.querySelector('input[name='Amount']').value = @(Model.MinimumNextBid + 25)">
                                        +$25
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm flex-fill"
                                            onclick="document.querySelector('input[name='Amount']').value = @(Model.MinimumNextBid + 50)">
                                        +$50
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle me-2"></i>
                                Please <a href="@Url.Action("Login", "Home", new { returnUrl = Context.Request.Path })" class="alert-link">log in</a> to place a bid.
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            This auction has ended. No more bids can be placed.
                        </div>
                    }

                    <!-- Bid Statistics -->
                    @if (Model.BidCount > 0)
                    {
                        <hr class="my-4">
                        <div class="small">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Total Bids:</span>
                                <span class="fw-bold">@Model.BidCount</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Last Bid:</span>
                                <span class="fw-bold">@Model.BidHistory.FirstOrDefault()?.TimeDisplay</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Auto-refresh bid status every 30 seconds
        @if (Model.IsAuctionActive)
        {
                <text>
                setTimeout(function() {
                    location.reload();
                }, 30000);
                </text>
        }
    </script>
}